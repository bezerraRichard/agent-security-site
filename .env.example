# agent-security: environment settings
# Copy to .env (never committed) and fill in the values you need. Variables already set in the shell win
# over this file. Empty values are ignored.

# --- OneTrust: cookie classification (read-only, API client with the COOKIE_READ scope) ---------------
# Tenant host; must be a *.onetrust.com host (e.g. app.onetrust.com, app-eu.onetrust.com).
ONETRUST_HOSTNAME=
ONETRUST_CLIENT_ID=
ONETRUST_CLIENT_SECRET=
# Language of the cookie descriptions (e.g. en, pt). Optional; default en.
ONETRUST_LANGUAGE=

# --- OneTrust: cookie recategorization from the console (separate API client with the COOKIE scope) -----
# Leave empty to keep writing disabled. Every change still needs explicit confirmation in the console.
ONETRUST_WRITE_CLIENT_ID=
ONETRUST_WRITE_CLIENT_SECRET=

# --- Paths and console ---------------------------------------------------------------------------------
# Folder where reports, the action plan state and the OneTrust audit log are kept (default: reports).
AGENT_SECURITY_REPORTS_DIR=
# Console port (default: 8501). The console only listens on localhost.
AGENT_SECURITY_CONSOLE_PORT=

# --- Network (optional) ----------------------------------------------------------------------------------
# Proxy used by the automatic route (system/environment proxy first, then direct). Use --proxy or the
# console's Network section to force one instead.
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1
# PAC script used by the automatic route when the system settings do not give one (any system); macOS and
# Linux need the PAC extra: pip install -e ".[pac]"
# AGENT_SECURITY_PAC_URL=http://pac.example/proxy.pac
